# ══════════════════════════════════════════════════════════════
#  FEEDiT 환경변수 견본
# ══════════════════════════════════════════════════════════════
#
#   cp .env.example .env      하고 값을 채웁니다.
#   .env 는 .gitignore 에 있습니다. ★ 절대 커밋하지 마세요.
#   이 파일(.env.example)에는 **실제 키를 적지 않습니다.**
#
#   설정이 맞는지 한 번에 보려면:
#       python3 ChatBot/tools_env_check.py
#
# ──────────────────────────────────────────────────────────────
#  1. Django
# ──────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=dev-바꾸세요
DJANGO_DEBUG=True

# ──────────────────────────────────────────────────────────────
#  2. DB — SSM 굴을 통해 RDS 로 나갑니다
#     docker compose 가 ssm-tunnel 컨테이너를 띄우고 5433 으로 받습니다.
# ──────────────────────────────────────────────────────────────
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5433

RDS_HOST=
RDS_PORT=5432

# ──────────────────────────────────────────────────────────────
#  3. AWS — SSM 굴과 S3
#     ★ 개인 IAM 키를 쓰세요. 공용 키를 돌려쓰면 누가 무엇을 했는지
#       추적이 안 되고, 한 사람이 유출되면 전원을 회수해야 합니다.
# ──────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_OUTPUT=json
AWS_REGION=ap-northeast-2
EC2_INSTANCE_ID=
AWS_STORAGE_BUCKET_NAME=

# ──────────────────────────────────────────────────────────────
#  4. Celery / Redis
# ──────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# ──────────────────────────────────────────────────────────────
#  5. 수집 API 키
# ──────────────────────────────────────────────────────────────
YOUTUBE_API_KEY=

# ══════════════════════════════════════════════════════════════
#  6. 챗봇 (ChatBot/)
# ══════════════════════════════════════════════════════════════
#
#  ── LLM ──────────────────────────────────────────────────────
#  ★ 각자 자기 키를 발급받아 넣습니다 (platform.openai.com → API keys).
#    한 사람 키를 다 같이 쓰면 한도가 한 번에 소진되고,
#    누가 얼마나 썼는지 볼 수 없습니다.
OPENAI_API_KEY=sk-여기에-본인-키

#  모델. 팀 표준은 gpt-5.6-luna 입니다. 바꿀 일이 있으면 팀에 알리고 바꾸세요 —
#  사람마다 다른 모델을 쓰면 "왜 답이 다르지" 를 영영 못 쫓습니다.
FEEDIT_LLM_MODEL=gpt-5.6-luna

#  추론 강도: none · low · medium · high · xhigh · max
#  low 로 충분합니다. 챗봇은 숫자를 만들지 않고 문장만 다듬기 때문입니다.
FEEDIT_LLM_EFFORT=low

#  1 로 두면 LLM 을 아예 안 부릅니다 — 규칙만으로 돕니다.
#  키가 없는 팀원도 화면을 볼 수 있게 하려면 이걸 켜세요.
FEEDIT_LLM_DISABLED=0

#  사내 게이트웨이를 쓸 때만. 보통은 비워 둡니다.
# OPENAI_BASE_URL=https://api.openai.com/v1

#  ── 챗봇 데이터 소스 ─────────────────────────────────────────
#  ★ 챗봇 엔진은 크롤러 저장소의 **데이터와 코드**가 둘 다 있어야 뜹니다.
#      data/feedit.db              지표
#      config/lexicon.yaml         어휘 사전
#      feedit_crawler/lexicon.py   lexicon_gate.py 가 import 합니다
#      tools/question_extract.py   어휘 추출기
#  받아 둔 곳의 절대경로를 적으세요.
FEEDIT_CRAWLER_DIR=/절대/경로/feedit-crawler

#  위 기본값으로 안 맞을 때만 개별 지정합니다.
# FEEDIT_CHAT_DB=/절대/경로/feedit-crawler/data/feedit.db
# FEEDIT_CHAT_LEXICON=/절대/경로/feedit-crawler/config/lexicon.yaml
# FEEDIT_EXTRACTOR_DIR=/절대/경로/tools

#  지표 버전. 크롤러가 계산할 때 쓴 값과 같아야 합니다.
FEEDIT_METRIC_VERSION=feedit-l2-v2-shadow

#  ── 챗봇 서버 ────────────────────────────────────────────────
#  ★ 인증이 없습니다. 기본값(127.0.0.1)을 그대로 두세요.
#    도커로 띄울 때만 compose 가 0.0.0.0 을 넣습니다
#    (그때도 포트는 호스트의 127.0.0.1 에만 묶습니다).
FEEDIT_CHAT_HOST=127.0.0.1
FEEDIT_CHAT_PORT=8770

#  프론트 dev 서버 주소가 다르면 쉼표로 이어 적습니다.
# FEEDIT_CHAT_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
