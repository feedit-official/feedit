/* ============================================================
   FEEDiT — 소개 페이지 인터랙션
   GSAP + ScrollTrigger / Lenis / 커스텀 라인 스플리터
   외부 의존은 셋뿐. 나머지는 직접 구현해 제출물 리스크를 줄인다.
   ============================================================ */

const PLATFORM_URL = 'https://fee-di-t-frontend.vercel.app/';

const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
const FINE    = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

/* ── 데이터 ────────────────────────────────────────── */

const LOOKS = [
  { f:'street',   ko:'스트릿',       en:'STREET',      d:+34 },
  { f:'gorp',     ko:'고프코어',     en:'GORPCORE',    d:+52 },
  { f:'ballet',   ko:'발레코어',     en:'BALLETCORE',  d:+41 },
  { f:'block',    ko:'블록코어',     en:'BLOKECORE',   d:+28 },
  { f:'ameka',    ko:'아메카지',     en:'AMEKAJI',     d:+12 },
  { f:'y2k',      ko:'Y2K',          en:'Y2K',         d:-18 },
  { f:'norm',     ko:'놈코어',       en:'NORMCORE',    d:+7  },
  { f:'grunge',   ko:'그런지',       en:'GRUNGE',      d:+23 },
  { f:'biz',      ko:'비즈캐주얼',   en:'BIZ CASUAL',  d:+16 },
  { f:'feminine', ko:'페미닌',       en:'FEMININE',    d:-6  },
  { f:'ath',      ko:'애슬레저',     en:'ATHLEISURE',  d:+19 },
  { f:'geek',     ko:'긱시크',       en:'GEEK CHIC',   d:+31 },
  { f:'bike',     ko:'바이크코어',   en:'BIKECORE',    d:+9  },
  { f:'classic',  ko:'클래식',       en:'CLASSIC',     d:+4  },
];

const METRICS = [
  { img:'f01', tag:'01 — MENTION',   val:124, unit:'K', suffix:'/day',
    name:'언급량 · 트렌드 온도', desc:'커머스와 콘텐츠 9개 소스에서 하루에 모으는 신호의 양. 6시간마다 갱신됩니다.', accent:true },
  { img:'f24', tag:'02 — LIFECYCLE', val:6, unit:'주', suffix:'남음',
    name:'수명주기', desc:'정점을 언제 지났는지, 하락까지 얼마가 남았는지 함께 봅니다.' },
  { img:'f11', tag:'03 — SENTIMENT', val:78, unit:'%', suffix:'',
    name:'긍부정 · 구매의향', desc:'언급이 늘어도 반응이 나쁜 키워드는 걸러냅니다.' },
  { img:'f20', tag:'04 — DISCOUNT',  val:-14, unit:'%', suffix:'',
    name:'할인률 변화', desc:'지금 사도 되는 가격인지, 더 기다려야 하는지.' },
  { img:'f35', tag:'05 — RESALE',    val:112, unit:'', suffix:'idx',
    name:'리세일 시세 지수', desc:'2차 시장이 정가를 넘겼는지로 열기를 재검증합니다.' },
  { img:'f17', tag:'06 — ASSOCIATION', val:5, unit:'축', suffix:'',
    name:'연관어 지도', desc:'소재 · 실루엣 · 컬러 · 무드 · 브랜드 다섯 축으로 키워드 주변을 펼칩니다.' },
];

const ITEMS = [
  { f:'puffer',        cat:'OUTER · 패딩',   title:'숏 다운 패딩 (네이비)',   price:'329,000', buy:71 },
  { f:'blouson',       cat:'OUTER · 자켓',   title:'코튼 워크 자켓 (카멜)',   price:'268,000', buy:64 },
  { f:'denim_jacket',  cat:'OUTER · 데님',   title:'코듀로이 카라 트러커',     price:'149,000', buy:38 },
  { f:'airforce',      cat:'SHOES · 스니커', title:'로우탑 레더 스니커 (화이트)', price:'139,000', buy:82 },
  { f:'ballcap',       cat:'ACC · 캡',       title:'코튼 볼캡 (네이비)',       price:'49,000',  buy:55 },
];

/* ── 유틸 ──────────────────────────────────────────── */

const $  = (s, r = document) => r.querySelector(s);
const $$ = (s, r = document) => [...r.querySelectorAll(s)];
const clamp = (v, a, b) => Math.min(b, Math.max(a, v));

/* 줄 단위 분해 → 마스크 리빌.
   SplitText 대신 직접 구현: 의존성 0, 동작 예측 가능. */
function splitLines(el){
  const rows = [...el.children].length ? [...el.children] : [el];
  rows.forEach(row => {
    const mask = document.createElement('span');
    mask.className = 'line-mask';
    const inner = document.createElement('span');
    inner.className = 'line-in';
    inner.innerHTML = row.innerHTML;
    mask.appendChild(inner);
    row.innerHTML = '';
    row.appendChild(mask);
  });
  return rows.map(r => r.querySelector('.line-in'));
}

/* 어절 단위 래핑 — 스크롤 따라 잉크가 물드는 문장용 */
function splitWords(el){
  const words = el.textContent.trim().split(/\s+/);
  el.innerHTML = words
    .map(w => `<span class="w">${w}</span>`)
    .join(' ');
  return $$('.w', el);
}

/* ── 마크업 주입 ───────────────────────────────────── */

function buildLookbook(){
  const track = $('#lbTrack');
  track.innerHTML = LOOKS.map((l, i) => {
    const up = l.d >= 0;
    return `
      <figure class="shot">
        <img src="./assets/look/${l.f}.jpg" alt="${l.ko} 스타일" loading="lazy" decoding="async">
        <span class="shot-idx">${String(i + 1).padStart(2, '0')}</span>
        <figcaption class="shot-cap">
          <span>
            <span class="shot-name">${l.ko}</span>
            <span class="shot-en">${l.en}</span>
          </span>
          <span class="delta ${up ? 'up' : 'dn'}">${up ? '▲' : '▼'} ${Math.abs(l.d)}%</span>
        </figcaption>
      </figure>`;
  }).join('');
}

function buildMetrics(){
  $('#mGrid').innerHTML = METRICS.map(m => `
    <article class="mc${m.accent ? ' accent' : ''}">
      <img src="./assets/ed/${m.img}.jpg" alt="" loading="lazy" decoding="async">
      <span class="veil"></span>
      <div class="mc-body">
        <span class="mc-tag">${m.tag}</span>
        <div class="mc-val" data-to="${m.val}" data-unit="${m.unit}">0<small>${m.suffix}</small></div>
        <h3 class="mc-name">${m.name}</h3>
        <p class="mc-desc">${m.desc}</p>
      </div>
    </article>`).join('');
}

function buildSalmal(){
  $('#smGrid').innerHTML = ITEMS.map(it => `
    <article class="vote" data-buy="${it.buy}">
      <div class="vote-fig">
        <img src="./assets/item/${it.f}.jpg" alt="${it.title}" loading="lazy" decoding="async">
        <span class="vote-live"><i></i>LIVE</span>
      </div>
      <div class="vote-body">
        <span class="vote-brand">${it.cat}</span>
        <h3 class="vote-title">${it.title}</h3>
        <span class="vote-price">${it.price}원</span>
        <div class="vote-acts">
          <button class="vbtn buy" type="button" data-v="buy">살!</button>
          <button class="vbtn no"  type="button" data-v="no">말?</button>
        </div>
        <div class="vote-res">
          <div class="res-bar"><i class="b"></i><i class="n"></i></div>
          <div class="res-num"><span class="b">살 ${it.buy}%</span><span class="n">말 ${100 - it.buy}%</span></div>
          <p class="res-say"></p>
        </div>
      </div>
    </article>`).join('');
}

/* ── 살!말? 체험 ───────────────────────────────────── */

function wireVotes(){
  $$('.vote').forEach(card => {
    const buy = +card.dataset.buy;
    card.addEventListener('click', e => {
      const btn = e.target.closest('.vbtn');
      if (!btn || card.classList.contains('done')) return;

      const mine  = btn.dataset.v;
      const major = buy >= 50 ? 'buy' : 'no';
      card.classList.add('done');

      $('.res-say', card).innerHTML = mine === major
        ? `취향이 비슷한 사람들도 <b>같은 선택</b>을 했습니다.`
        : `취향이 비슷한 사람들은 <b>반대로</b> 봤습니다.`;

      requestAnimationFrame(() => {
        $('.res-bar .b', card).style.width = buy + '%';
        $('.res-bar .n', card).style.width = (100 - buy) + '%';
      });
    });
  });
}

/* ── 플랫폼 진입 전환 ──────────────────────────────── */

function wirePlatformLinks(){
  const curtain = $('#curtain');
  $$('[data-platform]').forEach(a => {
    a.setAttribute('href', PLATFORM_URL);
    a.addEventListener('click', e => {
      if (e.metaKey || e.ctrlKey || e.shiftKey) return;   // 새 탭은 그대로
      e.preventDefault();

      if (REDUCED || !window.gsap){ location.href = PLATFORM_URL; return; }

      const tl = gsap.timeline({ onComplete: () => { location.href = PLATFORM_URL; } });
      tl.to(curtain, { y: '0%', duration: .78, ease: 'expo.inOut' })
        .to($('#curtain span'), { opacity: 1, duration: .34, ease: 'power2.out' }, '-=.24')
        .to({}, { duration: .22 });
    });
  });
}

/* ── 상단바: 지면 색 따라가기 + 스크롤 상태 ────────── */

function wireTopbar(){
  const bar   = $('.topbar');
  const first = $('.creed');
  const last  = $('.salmal');
  let ticking = false;

  const sync = () => {
    ticking = false;
    const y = window.scrollY || document.documentElement.scrollTop;
    document.body.classList.toggle('scrolled', y > 40);

    const top = first.getBoundingClientRect().top;
    const bot = last.getBoundingClientRect().bottom;
    bar.classList.toggle('on-paper', top <= 56 && bot >= 56);
  };

  window.addEventListener('scroll', () => {
    if (!ticking){ ticking = true; requestAnimationFrame(sync); }
  }, { passive: true });
  sync();
}

/* ── 커서 ──────────────────────────────────────────── */

function wireCursor(){
  if (!FINE || REDUCED) return;
  const dot  = $('#cursor');
  const ring = $('#cursorRing');
  document.body.classList.add('cur-on');

  const dx = gsap.quickTo(dot,  'x', { duration: .12, ease: 'power3' });
  const dy = gsap.quickTo(dot,  'y', { duration: .12, ease: 'power3' });
  const rx = gsap.quickTo(ring, 'x', { duration: .42, ease: 'power3' });
  const ry = gsap.quickTo(ring, 'y', { duration: .42, ease: 'power3' });

  window.addEventListener('pointermove', e => {
    dx(e.clientX); dy(e.clientY); rx(e.clientX); ry(e.clientY);
  }, { passive: true });

  const HOT = 'a, button, .shot, .vote';
  document.addEventListener('pointerover', e => {
    if (e.target.closest(HOT)) document.body.classList.add('cur-lg');
  });
  document.addEventListener('pointerout', e => {
    if (e.target.closest(HOT)) document.body.classList.remove('cur-lg');
  });
}

/* ── 마그네틱 버튼 ─────────────────────────────────── */

function wireMagnetic(){
  if (!FINE || REDUCED) return;
  $$('.magnetic').forEach(el => {
    const xTo = gsap.quickTo(el, 'x', { duration: .5, ease: 'elastic.out(1, .4)' });
    const yTo = gsap.quickTo(el, 'y', { duration: .5, ease: 'elastic.out(1, .4)' });
    el.addEventListener('pointermove', e => {
      const r = el.getBoundingClientRect();
      xTo((e.clientX - (r.left + r.width  / 2)) * .32);
      yTo((e.clientY - (r.top  + r.height / 2)) * .42);
    });
    el.addEventListener('pointerleave', () => { xTo(0); yTo(0); });
  });
}

/* ── 스크롤 연출 ───────────────────────────────────── */

function wireScroll(){
  gsap.registerPlugin(ScrollTrigger);

  /* Lenis 관성 스크롤 ↔ ScrollTrigger 동기화 */
  let lenis = null;
  if (window.Lenis && !REDUCED){
    lenis = new Lenis({ duration: 1.1, smoothWheel: true, lerp: .1 });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add(t => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);
  }

  /* 00 — 오프닝 등장 */
  const heroLines = splitLines($('.statement'));
  /* CSS 의 translateY(105%) 를 GSAP 은 px 단위 y 로 읽어 캐시한다.
     y:0 을 함께 넘겨 그 px 를 비워야 yPercent 트윈이 먹는다. */
  gsap.set(heroLines, { yPercent: 105, y: 0 });
  const tl = gsap.timeline({ delay: .18 });
  tl.to('.eyebrow', { opacity: 1, y: 0, duration: .8, ease: 'power3.out' })
    .to(heroLines, { yPercent: 0, y: 0, duration: 1.15, ease: 'expo.out', stagger: .1 }, '-=.5')
    .to('.op-sub',   { opacity: 1, y: 0, duration: .9, ease: 'power3.out' }, '-=.7')
    .to('.op-foot [data-rise]', { opacity: 1, y: 0, duration: .8, ease: 'power3.out', stagger: .08 }, '-=.6');

  /* 00 — 히어로 패럴랙스 */
  gsap.to('.op-bg img', {
    yPercent: 14, scale: 1.02, ease: 'none',
    scrollTrigger: { trigger: '.opening', start: 'top top', end: 'bottom top', scrub: true }
  });

  /* 01 — 문장에 잉크가 물든다 */
  const words = splitWords($('.inkline'));
  ScrollTrigger.create({
    trigger: '.creed',
    start: 'top 72%',
    end: 'bottom 72%',
    scrub: .4,
    onUpdate: self => {
      const lit = Math.round(self.progress * words.length);
      words.forEach((w, i) => w.classList.toggle('lit', i < lit));
    }
  });

  /* 02 — 룩북 가로 스크롤 (sticky + scrub) */
  const track = $('#lbTrack');
  const rail  = $('#lbRail');
  const dist  = () => Math.max(0, track.scrollWidth - window.innerWidth + 48);

  gsap.to(track, {
    x: () => -dist(), ease: 'none',
    scrollTrigger: {
      trigger: '.lookbook',
      start: 'top top', end: 'bottom bottom', scrub: .6,
      invalidateOnRefresh: true,
      onUpdate: self => {
        rail.style.transform = `translateX(${self.progress * (100 / .14 - 100)}%)`;
      }
    }
  });

  /* 스크롤 속도만큼 컷이 기운다 — 관성의 시각화 */
  let skew = 0;
  const shots = () => $$('.shot img');
  ScrollTrigger.create({
    trigger: '.lookbook', start: 'top bottom', end: 'bottom top',
    onUpdate: self => {
      const v = clamp(self.getVelocity() / -420, -14, 14);
      if (Math.abs(v) > Math.abs(skew)) skew = v;
    }
  });
  gsap.ticker.add(() => {
    skew += (0 - skew) * .08;
    if (Math.abs(skew) < .01) return;
    gsap.set(shots(), { skewY: skew * .34, scale: 1.06 + Math.abs(skew) * .002 });
  });

  /* 03 — 지표 카드: 클립 리빌 + 미세 패럴랙스 + 카운트업 */
  $$('.mc').forEach(card => {
    gsap.fromTo(card,
      { '--rv': 0 },
      {
        '--rv': 1, ease: 'power2.out',
        scrollTrigger: { trigger: card, start: 'top 92%', end: 'top 52%', scrub: .5 }
      });

    gsap.fromTo(card, { '--py': -1 }, {
      '--py': 1, ease: 'none',
      scrollTrigger: { trigger: card, start: 'top bottom', end: 'bottom top', scrub: true }
    });

    const valEl = $('.mc-val', card);
    const to    = +valEl.dataset.to;
    const unit  = valEl.dataset.unit;
    const small = $('small', valEl).outerHTML;
    const obj   = { n: 0 };

    ScrollTrigger.create({
      trigger: card, start: 'top 78%', once: true,
      onEnter: () => gsap.to(obj, {
        n: to, duration: 1.6, ease: 'expo.out',
        onUpdate: () => {
          const n = Math.round(obj.n);
          valEl.innerHTML = `${n > 0 && to < 0 ? '' : ''}${n}${unit}${small}`;
        }
      })
    });
  });

  /* 04 — 투표 카드 등장 */
  gsap.from('.vote', {
    y: 34, opacity: 0, duration: .9, ease: 'power3.out', stagger: .07,
    scrollTrigger: { trigger: '.sm-grid', start: 'top 84%' }
  });

  /* 05 — 마크가 커지며 진입 */
  const ouLines = splitLines($('.ou-title'));
  gsap.set(ouLines, { yPercent: 105, y: 0 });
  gsap.timeline({ scrollTrigger: { trigger: '.outro', start: 'top 62%' } })
    .from('#ouMark', { scale: .3, opacity: 0, rotate: -12, duration: 1.1, ease: 'expo.out' })
    .to(ouLines, { yPercent: 0, y: 0, duration: 1, ease: 'expo.out' }, '-=.7')
    .from('.ou-sub, .cta-lg, .ou-meta', { y: 20, opacity: 0, duration: .8, ease: 'power3.out', stagger: .09 }, '-=.6');

  /* 이미지가 늦게 뜨면 레이아웃이 바뀌므로 다시 잰다 */
  window.addEventListener('load', () => ScrollTrigger.refresh());
}

/* ── 모션 최소화 폴백 ──────────────────────────────── */

function staticFallback(){
  gsap.set('[data-rise]', { opacity: 1, y: 0 });
  $$('.line-in').forEach(l => l.style.transform = 'none');
  $$('.mc').forEach(c => {
    c.style.setProperty('--rv', 1);
    const v = $('.mc-val', c);
    v.innerHTML = `${v.dataset.to}${v.dataset.unit}${$('small', v).outerHTML}`;
  });
  $$('.w').forEach(w => w.classList.add('lit'));
}

/* ── 부팅 ──────────────────────────────────────────── */

buildLookbook();
buildMetrics();
buildSalmal();
wireVotes();
wirePlatformLinks();
wireTopbar();

if (window.gsap){
  if (REDUCED){
    splitLines($('.statement'));
    splitLines($('.ou-title'));
    splitWords($('.inkline'));
    staticFallback();
  } else {
    wireScroll();
    wireCursor();
    wireMagnetic();
  }
}
