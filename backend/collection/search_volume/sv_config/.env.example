# ===== 네이버 검색광고 API =====
NAVER_AD_API_KEY=your_api_key_here
NAVER_AD_SECRET_KEY=your_secret_key_here
NAVER_AD_CUSTOMER_ID=your_customer_id_here

# ===== 네이버 데이터랩 API =====
NAVER_CLIENT_ID=your_client_id_here
NAVER_CLIENT_SECRET=your_client_secret_here

# ===== Google Keyword Planner API (선택사항 - 나중에 추가) =====
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_client_id_here
GOOGLE_ADS_CLIENT_SECRET=your_client_secret_here
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token_here
GOOGLE_ADS_CUSTOMER_ID=your_customer_id_here
# Google Trends는 API 키가 필요 없습니다.

# ===== AWS S3 =====
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=your-bucket-name

# ===== AWS RDS (PostgreSQL) =====
RDS_HOST=your-rds-endpoint.rds.amazonaws.com
RDS_PORT=5432
RDS_DBNAME=your_database_name
RDS_USER=your_db_user
RDS_PASSWORD=your_db_password
